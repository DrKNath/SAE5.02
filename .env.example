# Copier ce fichier en .env (jamais commite) et adapter les valeurs.

NODE_ENV=development
PORT=3000

# Chemin utilise par Prisma. Dans Docker, /app/data est un volume nomme
# (sqlite_data) donc les donnees survivent aux rebuilds/redemarrages.
DATABASE_URL=file:/app/data/dev.db

# A changer absolument avant toute demo/mise en ligne.
JWT_SECRET=change-me

# Dossier de stockage des photos/videos uploadees (volume uploads_data).
UPLOADS_DIR=/app/uploads
